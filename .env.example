# copy to .env (gitignored). Two bots: Telegram allows only one long-poller per token.
TG_TOKEN=123456:research-bot-token          # research bot (scripts/tg_bot.py + notifications)
TG_CHAT_ID=123456789                        # your chat id; the bot only answers this chat
FREQTRADE__TELEGRAM__ENABLED=true           # Freqtrade's own bot (Phase 2)
FREQTRADE__TELEGRAM__TOKEN=123456:freqtrade-bot-token
FREQTRADE__TELEGRAM__CHAT_ID=123456789
